# 数据库：默认用 SQLite 文件，零配置即可运行
DATABASE_URL=file:./data/app.db

# 登录令牌的加密密钥，上线前务必换成一串足够长的随机字符
PAYLOAD_SECRET=请换成一串随机字符

# 可选：pnpm seed 创建的管理员账号（不填则用下面的默认值）
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456

# 内部积分接口（/api/credits/*）的密钥，只给自己的 MCP 网关和 AI 工具后端用。
# 不设置则这些接口一律返回 503。生成方法：openssl rand -hex 32
INTERNAL_API_SECRET=
